{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0 days"
  },
  "lockFileMaintenance": {
    "description": "pyproject.toml asks for ranges, so only a weekly lock refresh moves uv.lock to new releases.",
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Lock refreshes, pins and digests carry no release time, so the 3-day wait would hold them forever.",
      "matchUpdateTypes": ["lockFileMaintenance", "pin", "pinDigest", "digest"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "torchaudio only works with the torch build of the same release.",
      "groupName": "torch",
      "matchPackageNames": ["torch", "torchaudio"]
    }
  ]
}
